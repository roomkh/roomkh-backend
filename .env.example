# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=roomkh_db
POSTGRES_USER=roomkh_user
POSTGRES_PASSWORD=change_me_local_password

# Spring Boot datasource (used by application-dev.yml / application-prod.yml)
DB_URL=jdbc:postgresql://localhost:5432/roomkh_db
DB_USERNAME=roomkh_user
DB_PASSWORD=change_me_local_password

# JWT (will be used starting in the security step)
JWT_SECRET=change_me_to_a_long_random_secret_key
JWT_EXPIRATION=86400000